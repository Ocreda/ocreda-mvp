{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:isolated": "NEXT_DIST_DIR=.next-build next build",
    "start": "next start",
    "start:isolated": "NEXT_DIST_DIR=.next-build next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:functions": "tsc supabase/functions/_shared/relevance.ts supabase/functions/_shared/gemini.ts --outDir .relevance-build --module commonjs --target es2020 --skipLibCheck",
