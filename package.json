    "build:note-markdown": "tsc lib/note-markdown.ts lib/note-editor-extensions.ts lib/sample-vault-data.ts --outDir .note-markdown-build --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck",
